rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /households/{householdId} {
      // Reading by invite code (to join) happens before membership exists,
      // so any signed-in user may read/list households; documents only
      // contain a name, invite code and member ids.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;
      allow update: if isHouseholdMember(householdId) ||
        (isSignedIn() && request.auth.uid in request.resource.data.memberIds);
      allow delete: if false;

      match /measureTypes/{typeId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /measures/{measureId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }
  }
}
